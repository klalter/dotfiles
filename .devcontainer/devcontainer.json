{
  "name": "dotfiles",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Open the Explorer on /workspaces (the parent) rather than the dotfiles repo
  // itself, so repos you clone later show up as siblings in the same window.
  "workspaceFolder": "/workspaces",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Make dotfiles scripts available in every shell — including non-interactive
  // ones (tasks, terminals that don't source .bashrc). install.sh also appends
  // to .bashrc so `source ~/.bashrc` / new login shells keep working too.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/workspaces/dotfiles/scripts"
  },

  // onCreateCommand runs once after the container is first created.
  // install.sh: adds scripts/ to .bashrc, wires up GITHUB_TOKEN, installs Claude Code.
  "onCreateCommand": "bash /workspaces/dotfiles/install.sh",

  // postStartCommand runs every time the Codespace starts. Refresh skill
  // symlinks without network installs so new/changed skills become visible
  // after a restart, while still allowing live refresh with `merge-skills`.
  "postStartCommand": "bash -lc 'if command -v merge-skills >/dev/null 2>&1; then exec merge-skills; fi; for s in \"$HOME/.local/bin/merge-skills\" /workspaces/dotfiles/scripts/merge-skills /workspaces/kas-dotfiles/scripts/merge-skills /workspaces/*/scripts/merge-skills; do [ -x \"$s\" ] && exec \"$s\"; done'",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
