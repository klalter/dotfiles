{
	"editor.fontFamily": "'JetBrains Mono', 'Cascadia Code', 'Fira Code', 'SF Mono', Menlo, Consolas, 'Droid Sans Mono', monospace",
	"editor.fontSize": 15,
	"editor.lineHeight": 1.6,
	"editor.fontLigatures": true,
	"editor.fontWeight": "450",
	"editor.cursorBlinking": "smooth",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.smoothScrolling": true,
	"editor.bracketPairColorization.enabled": true,
	"editor.guides.bracketPairs": "active",
	"editor.renderLineHighlight": "all",
	"editor.renderWhitespace": "boundary",
	"editor.stickyScroll.enabled": true,
	"editor.minimap.renderCharacters": false,
	"terminal.integrated.fontFamily": "'JetBrains Mono', 'Cascadia Code', 'Fira Code', 'SF Mono', Menlo, Consolas, monospace",
	"terminal.integrated.fontSize": 14,
	"terminal.integrated.lineHeight": 1.2,
	"terminal.integrated.smoothScrolling": true,
	"terminal.integrated.gpuAcceleration": "auto",
	"terminal.integrated.mouseWheelScrollSensitivity": 1,
	"terminal.integrated.fastScrollSensitivity": 5,
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.cursorStyle": "line",
	"workbench.list.smoothScrolling": true,
	"workbench.editor.tabSizing": "shrink",
	"chat.useAgentsMdFile": true,
	"chat.instructionsFilesLocations": {
		"~/.copilot/instructions": true
	}
}
