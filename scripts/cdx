#!/usr/bin/env bash
# cdx — launch OpenAI Codex in "yolo" mode (no approval prompts, no sandbox).
#
# Mirror of cld: self-sufficient, installs the Codex CLI on first run if it's
# missing. Claude (cld) is what install.sh puts on new boxes by default;
# Codex is opt-in — the first `cdx` pulls it in.
set -euo pipefail

log() { printf '[cdx] %s\n' "$*" >&2; }

ensure_codex() {
  command -v codex >/dev/null 2>&1 && return 0

  if [ -x "$HOME/.local/bin/codex" ]; then
    PATH="$HOME/.local/bin:$PATH"
    return 0
  fi

  log "Codex CLI not found — installing..."
  if command -v npm >/dev/null 2>&1; then
    npm install -g @openai/codex >&2
  else
    log "could not install Codex (need npm on PATH — install Node.js first)"
    exit 1
  fi

  if ! command -v codex >/dev/null 2>&1; then
    log "Codex install did not put 'codex' on PATH"
    exit 1
  fi
  log "Codex installed: $(codex --version 2>/dev/null || echo unknown)"
}

ensure_codex
exec codex --dangerously-bypass-approvals-and-sandbox "$@"
