# Locally-injected CA certs for proxied builds — never commit these.
devbox/extra-ca/*.crt
devbox/extra-ca/*.pem

# Node dependencies and lock files
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
installation_id

# Python bytecode — never commit
__pycache__/
*.pyc

# worktree-sync hook scratch: the PostToolUse hint queue, the flush log, the
# flush lock and any parked exit-3 conflict block. Transient per-machine state,
# not versioned data — the manifests next to it are the versioned part.
projects/.queue/
